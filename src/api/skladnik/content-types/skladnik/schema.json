{
  "kind": "collectionType",
  "collectionName": "skladniks",
  "info": {
    "singularName": "skladnik",
    "pluralName": "skladniks",
    "displayName": "Składnik",
    "description": "Baza składników do przepisów"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "kcal": {
      "type": "integer",
      "required": true
    },
    "protein": {
      "type": "decimal",
      "required": true
    },
    "carbs": {
      "type": "decimal",
      "required": true
    },
    "fat": {
      "type": "decimal",
      "required": true
    },
    "fiber": {
      "type": "decimal",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "unitType": {
      "type": "enumeration",
      "enum": [
        "weight",
        "volume",
        "piece"
      ],
      "required": true
    },
    "averagePieceWeight": {
      "type": "integer"
    },
    "isAiEnriched": {
      "type": "boolean",
      "default": false
    },
    "recipes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::recipe.recipe",
      "mappedBy": "used_ingredients"
    }
  }
}
