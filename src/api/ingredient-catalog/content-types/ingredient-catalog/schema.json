{
  "kind": "collectionType",
  "collectionName": "ingredients_v2",
  "info": {
    "singularName": "ingredient-catalog",
    "pluralName": "ingredient-catalogs",
    "displayName": "Składnik (Katalog)",
    "description": "Baza składników (Nowa instancja)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "kcal": {
      "type": "integer",
      "required": true
    },
    "protein": {
      "type": "decimal",
      "required": true
    },
    "carbs": {
      "type": "decimal",
      "required": true
    },
    "fat": {
      "type": "decimal",
      "required": true
    },
    "fiber": {
      "type": "decimal",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "unitType": {
      "type": "enumeration",
      "enum": [
        "weight",
        "volume",
        "piece"
      ],
      "required": true
    },
    "averagePieceWeight": {
      "type": "integer"
    },
    "recipes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::recipe.recipe",
      "mappedBy": "used_ingredients"
    }
  }
}
